# Copy to `local.properties` and fill in. That file is git-ignored.
# `sdk.dir` is written automatically by Android Studio on first sync.

sdk.dir=D:\\Android

# Supabase project shared with the web app (forest-voice-news.lovable.app).
# Project ref: ghsmnpqigzocbiatpjid
SUPABASE_URL=https://ghsmnpqigzocbiatpjid.supabase.co

# The publishable "anon" key. Safe in a client binary — every table is RLS-protected.
# Copy from the web app's .env (VITE_SUPABASE_PUBLISHABLE_KEY) or the Supabase dashboard.
SUPABASE_ANON_KEY=

# OAuth 2.0 *Web application* client ID from the Google Cloud console — NOT the Android
# client ID. Credential Manager wants the server client ID, and Supabase must be
# configured with the same one under Auth > Providers > Google.
GOOGLE_WEB_CLIENT_ID=

# Base URL of the web app, used for the manual-trigger endpoint.
WEB_APP_BASE_URL=https://forest-voice-news.lovable.app

# NOTE: CRON_SECRET deliberately has no entry here. It must never ship in the APK —
# see ARCHITECTURE.md "Manual trigger".
